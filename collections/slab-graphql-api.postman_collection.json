              "body": "{\n  \"data\": {\n    \"key_0\": 8760,\n    \"key_1\": true\n  },\n  \"errors\": [\n    {\n      \"message\": \"string\",\n      \"path\": [\n        \"string\",\n        \"string\"\n      ],\n      \"locations\": [\n        {\n          \"line\": 7765,\n          \"column\": 7316\n        },\n        {\n          \"line\": 4653,\n          \"column\": 150\n        }\n      ]\n    },\n    {\n      \"message\": \"string\",\n      \"path\": [\n        \"string\",\n        \"string\"\n      ],\n      \"locations\": [\n        {\n          \"line\": 2678,\n          \"column\": 1534\n        },\n        {\n          \"line\": 3235,\n          \"column\": 7914\n        }\n      ]\n    }\n  ]\n}",
